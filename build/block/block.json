{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "dmg/read-more",
  "title": "DMG Read More",
  "category": "text",
  "description": "Insert a styled Read More link to any published post.",
  "attributes": {
    "postId": {
      "type": "integer"
    },
    "postTitle": {
      "type": "string"
    },
    "postType": {
      "type": "string"
    }
  },
  "supports": {
    "align": true,
    "color": {
      "background": true,
      "link": true,
      "text": true
    },
    "html": false,
    "spacing": {
      "padding": true,
      "margin": true
    },
    "typography": {
      "fontSize": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./view.css",
  "viewStyle": "file:./view.css",
  "render": "file:./render.php"
}