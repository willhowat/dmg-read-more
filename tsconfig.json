{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["ES2020", "DOM"],
		"module": "ES2015",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"strict": true,
		"noEmit": true,
		"allowJs": true,
		"checkJs": false,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "build"]
}
